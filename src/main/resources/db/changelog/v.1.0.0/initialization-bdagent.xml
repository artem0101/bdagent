                <constraints nullable="false"/>
            </column>
            <column name="rooms" type="INT" remarks="Количество комнат">
                <constraints nullable="false"/>
            </column>
            <column name="area_ground" type="NUMERIC(10,2)" remarks="Площадь земельного участка">
                <constraints nullable="false"/>
            </column>
            <column name="area_house" type="NUMERIC(10,2)" remarks="Площадь дома">
                <constraints nullable="false"/>
            </column>
