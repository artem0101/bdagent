    <changeSet id="initial-createTable-realtor_agency.clients" author="username" dbms="postgresql">
        <createTable schemaName="realtor_agency" tableName="clients" remarks="Клиенты">
            <column name="id" type="BIGINT" remarks="Идентификатор клиента">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="surname" type="TEXT" remarks="Фамилия">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT" remarks="Имя">
                <constraints nullable="false"/>
            </column>
            <column name="patronymic" type="TEXT" remarks="Отчество">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="BIGINT" remarks="Номер телефона">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="TEXT" remarks="Почтовый ящик">
                <constraints nullable="false"/>
            </column>
            <column name="birthday" type="TIMESTAMP" remarks="Дата рождения">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="TEXT" remarks="Тип клиента">
