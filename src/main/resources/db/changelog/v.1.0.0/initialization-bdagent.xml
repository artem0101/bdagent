            <column name="client_id" type="BIGINT" remarks="Клиент">
                <constraints nullable="false"/>
            </column>
            <column name="subject_id" type="BIGINT" remarks="Объект">
                <constraints nullable="false"/>
            </column>
            <column name="is_subject_owner" type="BOOLEAN" remarks="Является клиент владельцем">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

