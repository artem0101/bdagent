    <changeSet id="initial-createTable-realtor_agency.transactions" author="username" dbms="postgresql">
        <createTable schemaName="realtor_agency" tableName="transactions" remarks="Транзакции">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="subject_id" type="BIGINT" remarks="Объект">
                <constraints nullable="false"/>
            </column>
            <column name="seller_id" type="BIGINT" remarks="Продавец">
                <constraints nullable="false"/>
            </column>
            <column name="buyer_id" type="BIGINT" remarks="Покупатель">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT" remarks="Сотрудник">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="TIMESTAMP" remarks="Дата транзакции"/>
            <column name="amount" type="NUMERIC(10,2)" remarks="Сумма транзакции" defaultValue="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="TEXT" remarks="Статус транзакции" defaultValue="Создана">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

