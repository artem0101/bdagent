<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="init-createSchema-realty_agency" author="username" dbms="postgresql">
        <sql endDelimiter=";">
            CREATE SCHEMA IF NOT EXISTS realtor_agency;
        </sql>
    </changeSet>

    <changeSet id="initial-createTable-realty_agency.subjects" author="username" dbms="postgresql">
        <createTable schemaName="realtor_agency" tableName="subjects" remarks="Таблица объектов">
            <column name="id" type="BIGINT" remarks="Идентификатор объекта">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="country" type="TEXT" remarks="Страна">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="TEXT" remarks="Город">
                <constraints nullable="false"/>
            </column>
            <column name="postal_code" type="VARCHAR(20)" remarks="Почтовый индекс"/>
            <column name="street" type="TEXT" remarks="Улица">
                <constraints nullable="false"/>
            </column>
            <column name="number" type="TEXT" remarks="Номер">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(10,2)" remarks="Цена">
                <constraints nullable="false"/>
            </column>
            <column name="is_available" type="BOOLEAN" remarks="Доступен для продажи" defaultValue="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="initial-createSequence-realty_agency.subject_id_seq" author="username" dbms="postgresql">
        <createSequence schemaName="realtor_agency" sequenceName="subject_id_seq" startValue="2000"/>
    </changeSet>

    <changeSet id="initial-createTable-realty_agency.apartments" author="username" dbms="postgresql">
        <createTable schemaName="realtor_agency" tableName="apartments" remarks="Квартиры">
            <column name="id" type="BIGINT" remarks="Идентификатор квартиры">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="subject_id" type="BIGINT" remarks="Объект">
                <constraints nullable="false"/>
            </column>
            <column name="floor" type="INT" remarks="Этаж">
                <constraints nullable="false"/>
            </column>
            <column name="rooms" type="INT" remarks="Количество квартир">
                <constraints nullable="false"/>
            </column>
            <column name="area" type="NUMERIC(10,2)" remarks="Площадь">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="initial-addForeignKeyConstraint-realtor_agency.fk_apartments_subjects" author="username" dbms="postgresql">
        <addForeignKeyConstraint
                baseTableSchemaName="realtor_agency"
                baseTableName="apartments"
                baseColumnNames="subject_id"
                referencedTableSchemaName="realtor_agency"
                referencedTableName="subjects"
                referencedColumnNames="id"
                onDelete="CASCADE"
                constraintName="fk_apartments_subjects"/>
    </changeSet>

    <changeSet id="initial-createSequence-realtor_agency.apartments_id_seq" author="username" dbms="postgresql">
        <createSequence schemaName="realtor_agency" sequenceName="apartments_id_seq" startValue="2000"/>
    </changeSet>

